<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <p>Browse service projects by category:</p>

  <ul>
    <% categories.forEach((category) => { %>
      <li>
        <%= category.name %>
        (<a href="/edit-category/<%= category.category_id %>">Edit</a>)
      </li>
    <% }) %>
  </ul>
  <p><a href="/new-category">Add a new category</a></p>
</main>

<%- include('partials/footer') %>