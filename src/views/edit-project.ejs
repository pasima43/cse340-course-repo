<%- include('partials/header') %>
<%
  const d = new Date(projectDetails.date);
  const dateValue = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
%>
<main>
  <h1><%= title %></h1>

  <form
    action="/edit-project/<%= projectDetails.project_id %>"
    method="POST"
  >
    <div class="form-group">
      <label for="title">Project Title</label>
      <input
        type="text"
        id="title"
        name="title"
        value="<%= projectDetails.title %>"
        required
        maxlength="150"
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description" required maxlength="1000"><%= projectDetails.description %></textarea>
    </div>

    <div class="form-group">
      <label for="location">Location</label>
      <input
        type="text"
        id="location"
        name="location"
        value="<%= projectDetails.location %>"
        required
        maxlength="200"
      />
    </div>

    <div class="form-group">
      <label for="date">Date</label>
      <input
        type="date"
        id="date"
        name="date"
        value="<%= dateValue %>"
        required
      />
    </div>

    <div class="form-group">
      <label for="organizationId">Organization</label>
      <select id="organizationId" name="organizationId" required>
        <% organizations.forEach((organization) => { %>
          <option
            value="<%= organization.organization_id %>"
            <%= organization.organization_id === projectDetails.organization_id ? "selected" : "" %>
          >
            <%= organization.name %>
          </option>
        <% }); %>
      </select>
    </div>

    <button type="submit">Update Project</button>
  </form>
</main>
<%- include('partials/footer') %>