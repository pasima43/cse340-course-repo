<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>

  <h2><%= projectDetails.title %></h2>

  <form
    action="/assign-categories/<%= projectDetails.project_id %>"
    method="POST"
  >
    <% categories.forEach((category) => { %>
      <div class="form-group">
        <input
          type="checkbox"
          id="category-<%= category.category_id %>"
          name="categoryIds"
          value="<%= category.category_id %>"
          <%= assignedCategories.some((assigned) => assigned.category_id === category.category_id) ? "checked" : "" %>
        />
        <label for="category-<%= category.category_id %>"><%= category.name %></label>
      </div>
    <% }); %>

    <button type="submit">Update Categories</button>
  </form>
</main>
<%- include('partials/footer') %>