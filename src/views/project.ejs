<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>

  <h2><%= projectDetails.title %></h2>

  <p>Organization: <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a></p>
  <p>Date: <%= new Date(projectDetails.date).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric"
  }) %></p>
  <p>Location: <%= projectDetails.location %></p>
  <p>Description: <%= projectDetails.description %></p>

  <p><a href="/edit-project/<%= projectDetails.project_id %>">Edit this project</a></p>
  <p><a href="/assign-categories/<%= projectDetails.project_id %>">Edit Categories</a></p>
</main>
<%- include('partials/footer') %>